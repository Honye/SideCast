    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SideCast.app", "id": "BFECF87530B45DE400931585", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SideCastAudio.driver", "id": "5C1DECA57D0000000000A002", "type": "wrapper.cfbundle", "index": false },
