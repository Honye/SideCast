      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已解锁"
          }
        }
      }
    },
    "Unlocked by %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已由 %@ 解锁"
          }
        }
      }
    },
    "Unlocked while connected to %@": {
      "localizations": {
        "zh-Hans": {
