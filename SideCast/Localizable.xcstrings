        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac（不改变）"
          }
        }
      }
    },
    "This Mac appears on the other Mac as “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 在另一台 Mac 上显示为“%@”。"
          }
        }
      }
    },
    "This Mac is already connected to another device without SideCast Premium. Buy Premium on this device to connect it alongside others.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已连接另一台未购买 SideCast 高级版的设备。在本设备上购买高级版后，即可与其他设备同时连接。"
          }
        }
      }
    },
    "This Mac plays audio from another Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 播放另一台 Mac 的声音"
