{
  "sourceLanguage": "en",
  "strings": {
    "%@ (offline)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（离线）"
          }
        }
      }
    },
    "%@ · %lld%%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld%%"
          }
        }
      }
    },
    "%@ · Muted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 已静音"
          }
        }
      }
    },
    "%lld connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接 %lld 台"
          }
        }
      }
    },
    "%lld processes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个进程"
          }
        }
      }
    },
    "000000": {
      "shouldTranslate": false
    },
    "A one-time purchase. While this device is connected, your Mac can send each app to a different output, set each app's volume, and connect several devices at once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。本设备连接期间，你的 Mac 可以把不同应用输出到不同设备、单独调节每个应用的音量，并同时连接多台设备。"
          }
        }
      }
    },
    "A removed device has to enter a new pairing code the next time it connects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除后，该设备下次连接时需要重新输入配对码。"
          }
        }
      }
    },
    "Activate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活"
          }
        }
      }
    },
    "Advanced mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级模式"
          }
        }
      }
    },
    "Allow SideCast in Login Items to finish turning this on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「登录项」中允许 SideCast 以完成开启。"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Apps that play sound appear here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发声的应用会显示在这里。"
          }
        }
      }
    },
    "Apps you don't change play through the Mac as usual. Your choices are remembered for each app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未调整的应用照常从 Mac 发声。你的设置会按应用记住。"
          }
        }
      }
    },
    "Audio keeps playing when you lock the screen or switch apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏或切换到其他 App 时，音频会继续播放。"
          }
        }
      }
    },
    "Audio mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频模式"
          }
        }
      }
    },
    "Both devices are in the same mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备处于相同模式。"
          }
        }
      }
    },
    "Buy SideCast Premium…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买 SideCast 高级版…"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Choose this device as an app's output on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上把某个应用的输出设为这台设备。"
          }
        }
      }
    },
    "Collapsed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收起"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "Connected to %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接到 %@"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "Could not start audio playback.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始播放音频。"
          }
        }
      }
    },
    "Couldn't reach the license server. Check your internet connection and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接许可证服务器，请检查网络后重试。"
          }
        }
      }
    },
    "Deactivate on This Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上停用"
          }
        }
      }
    },
    "Debug trace": {
      "shouldTranslate": false
    },
    "Device offline": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备离线"
          }
        }
      }
    },
    "Devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备"
          }
        }
      }
    },
    "Disconnect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Enter the code shown on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %@ 上显示的配对码"
          }
        }
      }
    },
    "Enter this code on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上输入此配对码"
          }
        }
      }
    },
    "Expanded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开"
          }
        }
      }
    },
    "Follow the app's setting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随应用设置"
          }
        }
      }
    },
    "Forget": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Free version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通用"
          }
        }
      }
    },
    "High quality": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高音质"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Learn about Premium…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解高级版…"
          }
        }
      }
    },
    "Lets you route and set the volume of each kind of process inside an app separately, for example a browser's helper processes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可对应用内不同类型的进程（例如浏览器的辅助进程）分别设置输出设备和音量。"
          }
        }
      }
    },
    "License activation isn't available in this build yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本暂不支持激活许可证。"
          }
        }
      }
    },
    "License key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许可证密钥"
          }
        }
      }
    },
    "Local network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络"
          }
        }
      }
    },
    "Local network access is off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络权限已关闭"
          }
        }
      }
    },
    "Looking for Macs running SideCast…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找运行 SideCast 的 Mac…"
          }
        }
      }
    },
    "Low latency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低延迟"
          }
        }
      }
    },
    "Low latency suits video, calls and games. High quality sends lossless audio with a little more delay.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低延迟适合视频、通话和游戏；高音质传输无损音频，延迟稍高。"
          }
        }
      }
    },
    "Mac audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 声音"
          }
        }
      }
    },
    "Main process": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主进程"
          }
        }
      }
    },
    "Make sure SideCast is running on your Mac and both devices have Wi-Fi turned on. This device appears on the Mac as “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 Mac 上的 SideCast 正在运行，且两台设备都已打开 Wi-Fi。本设备在 Mac 上显示为“%@”。"
          }
        }
      }
    },
    "Mute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静音"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "Nearby Macs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的 Mac"
          }
        }
      }
    },
    "Nearby devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的设备"
          }
        }
      }
    },
    "Needed to find and connect to your devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于查找并连接你的设备。"
          }
        }
      }
    },
    "Needed to take an app's sound and play it on another device or at another volume. SideCast never records or saves audio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于获取应用的声音，以便在其他设备上或以其他音量播放。SideCast 不会录制或保存音频。"
          }
        }
      }
    },
    "No paired devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已配对的设备。"
          }
        }
      }
    },
    "No sound is coming from the apps SideCast controls. If they are playing, allow SideCast to record system audio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 控制的应用没有传来声音。如果它们正在播放，请允许 SideCast 录制系统音频。"
          }
        }
      }
    },
    "Not Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        }
      }
    },
    "Off. SideCast can't find your devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭，SideCast 无法找到你的设备。"
          }
        }
      }
    },
    "Open Login Items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开登录项"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "Open SideCast on your iPad to see it here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 上打开 SideCast，它就会出现在这里。"
          }
        }
      }
    },
    "Open SideCast on your iPad. It appears here when it's on the same Wi-Fi network or nearby.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 上打开 SideCast。当它与 Mac 在同一 Wi-Fi 网络或就在附近时，会显示在这里。"
          }
        }
      }
    },
    "Open SideCast when you log in": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时打开 SideCast"
          }
        }
      }
    },
    "Output": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出"
          }
        }
      }
    },
    "Output for all Mac audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 全部声音的输出"
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对"
          }
        }
      }
    },
    "Pair Device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对设备"
          }
        }
      }
    },
    "Paired %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对于 %@"
          }
        }
      }
    },
    "Paired devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备"
          }
        }
      }
    },
    "Paired · Tap to connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对 · 轻点以连接"
          }
        }
      }
    },
    "Per-app output and volume are part of SideCast Premium.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分应用设置输出和音量属于 SideCast 高级版功能。"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        }
      }
    },
    "Premium adds per-app output and volume, and lets you connect several devices at once. It's a one-time purchase. If an iPad or iPhone bought Premium in the App Store, it's unlocked while that device is connected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级版可分应用设置输出和音量，并可同时连接多台设备，一次性购买。如果某台 iPad 或 iPhone 已在 App Store 购买高级版，它连接期间这台 Mac 也会解锁。"
          }
        }
      }
    },
    "Premium unlocked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级版已解锁"
          }
        }
      }
    },
    "Process %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进程 %@"
          }
        }
      }
    },
    "Quit SideCast": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 SideCast"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        }
      }
    },
    "Reset to system default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复为系统默认"
          }
        }
      }
    },
    "Restart Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启"
          }
        }
      }
    },
    "Restart SideCast to use the new language.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启 SideCast 后新语言生效。"
          }
        }
      }
    },
    "Restore Purchases": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复购买"
          }
        }
      }
    },
    "Same as System": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "Same as app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随应用"
          }
        }
      }
    },
    "Saved settings for apps that aren't running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未运行应用的已保存设置"
          }
        }
      }
    },
    "Sends all of the Mac's sound to one place.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Mac 的全部声音输出到同一个设备。"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "SideCast": {
      "shouldTranslate": false
    },
    "SideCast Premium": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 高级版"
          }
        }
      }
    },
    "SideCast Premium is unlocked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 高级版已解锁"
          }
        }
      }
    },
    "SideCast Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 设置"
          }
        }
      }
    },
    "SideCast can't find your devices because local network access is off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地网络权限已关闭，SideCast 无法找到你的设备。"
          }
        }
      }
    },
    "SideCast could not capture app audio. Check the permission in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 无法获取应用音频，请在系统设置中检查权限。"
          }
        }
      }
    },
    "SideCast devices": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 设备"
          }
        }
      }
    },
    "SideCast needs local network access to find your Mac. Turn it on in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 需要本地网络权限才能找到你的 Mac，请在设置中打开。"
          }
        }
      }
    },
    "SideCast volume": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SideCast 音量"
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "System Default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统默认"
          }
        }
      }
    },
    "System audio recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制系统音频"
          }
        }
      }
    },
    "Tap to pair and connect": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点以配对并连接"
          }
        }
      }
    },
    "The App Store isn't available right now. Try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法连接 App Store，请稍后再试。"
          }
        }
      }
    },
    "The code is valid for 2 minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码 2 分钟内有效。"
          }
        }
      }
    },
    "The connection failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败。"
          }
        }
      }
    },
    "The connection was lost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已断开。"
          }
        }
      }
    },
    "The device could not be verified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证该设备。"
          }
        }
      }
    },
    "The free version connects one device at a time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版一次只能连接一台设备。"
          }
        }
      }
    },
    "The free version connects one device at a time. With Premium you can connect several devices and send different apps to each.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版一次只能连接一台设备。升级到高级版后，可以同时连接多台设备，并把不同应用分别输出到不同设备。"
          }
        }
      }
    },
    "The pairing code expired. Try again to get a new code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码已过期，请重新连接以获取新的配对码。"
          }
        }
      }
    },
    "The pairing code was incorrect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码不正确。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac"
          }
        }
      }
    },
    "This Mac (no change)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac（不改变）"
          }
        }
      }
    },
    "This Mac uses the free version of SideCast, which connects one device at a time. SideCast Premium on this device or the Mac removes the limit.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 使用的是 SideCast 免费版，一次只能连接一台设备。在本设备或 Mac 上购买高级版即可取消此限制。"
          }
        }
      }
    },
    "This device is in use by %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备正在被 %@ 使用。"
          }
        }
      }
    },
    "This license key could not be activated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法激活此许可证密钥。"
          }
        }
      }
    },
    "This license key is not for SideCast.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证密钥不属于 SideCast。"
          }
        }
      }
    },
    "This needs SideCast Premium": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能需要 SideCast 高级版"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
