    },
    "This needs SideCast Premium on the device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在该设备上购买 SideCast 高级版"
          }
        }
      }
    },
    "To mirror to several devices at once, each of them needs SideCast Premium. Stop mirroring to the other device first, or buy Premium in SideCast on the devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要同时镜像到多台设备，每台设备都需要 SideCast 高级版。请先停止镜像到另一台设备，或在这些设备上的 SideCast 中购买高级版。"
          }
        }
      }
    },
    "To send a single app to %@, buy SideCast Premium in SideCast on %@. Until then %@ can play the other sound.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要把单个应用投到 %1$@，请在 %2$@ 的 SideCast 中购买高级版。在此之前，%3$@ 可以播放「其他声音」。"
          }
        }
      }
    },
    "Trusted automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动信任"
          }
        }
      }
