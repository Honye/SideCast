            "state": "translated",
            "value": "连接 %@ 期间已解锁"
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消静音"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量"
          }
        }
      }
    },
    "Waiting for pairing code…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待输入配对码…"
          }
        }
      }
    },
    "With Premium you can choose an output and volume for each app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到高级版后，可以为每个应用单独选择输出设备和音量。"
          }
        }
      }
    },
    "Your license is no longer valid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的许可证已失效。"
          }
        }
      }
    },
    "macOS asks for these the first time SideCast needs them. You can change them in System Settings › Privacy & Security.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在 SideCast 首次需要时请求这些权限，你也可以在「系统设置 › 隐私与安全性」中更改。"
          }
        }
      }
    }
